<Project>
  <!-- Define GamePath property in Local.props -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />
  <PropertyGroup Condition="'$(GamePath)' != ''">
    <ManagedDir>$(GamePath)/Wrath_Data/Managed/</ManagedDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Ignore warning about missing XML comment on accessible types and params -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Allow access of private members at runtime. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Enable ContinuousIntegrationBuild to shorten and anonymizes paths in debug symbols relative to the project
    directory. Breakpoints will not work, however. PathMap doesn't work for linked Common sources.
    -->
    <Deterministic>true</Deterministic>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Shared source for mods
  https://github.com/dotnet/sdk/issues/2511#issuecomment-1374125096 -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/Common/**/*.cs" LinkBase="Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- Format on build -->
    <PackageReference Include="CSharpier.MsBuild" Version="1.2.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Allows using newer Language features in projects targeting older runtimes.
     This doesn't add any support for features that need types on runtime such as KeyValuePair deconstructing, etc. -->
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference
      Include="BepInEx.AssemblyPublicizer.MSBuild"
      Version="0.4.2"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference
      Include="$(ManagedDir)/*.dll;$(ManagedDir)/UnityModManager/*.dll"
      Exclude="$(ManagedDir)/Assembly-CSharp*.dll;$(ManagedDir)/0Harmony.dll;$(ManagedDir)/System*.dll;$(ManagedDir)/mscorlib.dll;$(ManagedDir)/netstandard.dll;"
      Private="false"
    />
  </ItemGroup>

  <Target Name="CleanupPublishDir" AfterTargets="Publish">
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <FilesToDelete Include="$(PublishDir)*.deps.json;" />
    </ItemGroup>
    <!-- .pdb is not excluded, so make sure ContinuousIntegrationBuild is set when building for distribution. -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <FilesToDelete Include="$(PublishDir)*.deps.json;" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)">
      <Output TaskParameter="DeletedFiles" ItemName="FilesDeleted" />
    </Delete>
  </Target>
</Project>
