set dotenv-required
set unstable
set lists

# Define MOD_PATH in .env
# No backslashes in path

release:
    dotnet publish -c Release -p:ContinuousIntegrationBuild=true *.csproj

[default]
build:
    dotnet publish -c Debug -p:ContinuousIntegrationBuild=true *.csproj

[script]
_copy-mod-to mods_dir type:
    {{ assert(trim(mods_dir) != '', 'Empty mods_dir') }}

    dest="{{ mods_dir }}"
    mkdir -p "$dest"

    echo >&2 "Copying mod to \"$dest\""

    cp -t "$dest" bin/{{ type }}/publish/*

[arg("mods_dir", help="Default is MOD_PATH env var if empty")]
[script]
dev mods_dir='': build
    mods_dir='{{ mods_dir }}'
    if [ '{{ trim(mods_dir) }}' = '' ]; then
        {{ assert(trim(env('MOD_PATH', '')) != '', 'Missing or empty MOD_PATH env var') }}
        mods_dir="$MOD_PATH"
    fi

    name="$(just -q _get-name)"
    dest="$mods_dir/$name"

    just _copy-mod-to "$dest" Debug

[doc("Package mod in a zip archive.")]
[script]
pack output_dir: release
    tempdir="$(mktemp -d)"
    function cleanup() {
        rm -rf "$tempdir"
    }
    trap cleanup EXIT

    name="$(just -q _get-name)"
    modname="$name"

    dest="$tempdir/$name"

    just _copy-mod-to "$dest" Release

    zip="{{ output_dir }}/$modname.zip"
    rm -f "$zip"

    7z a "$zip" "$tempdir"/*

[script]
_get-name:
    csproj="$(echo *.csproj)"

    if [ -n "$csproj" ]; then
        name="$(dotnet msbuild -getProperty:AssemblyTitle "$csproj")"
    else
        name="$(basename "{{ justfile_directory() }}")"
    fi

    echo "$name"
